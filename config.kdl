// ~/.config/niri/config.kdl
// whyCARE v3 — Niri Scrollable-Tiling Wayland Compositor
// Theme: Catppuccin Mocha | Hardware: Intel X299 / AMD RX 480

// ==============================================================================
// INPUT
// ==============================================================================
input {
    keyboard {
        xkb {
            layout "us"
            options "caps:escape"   // Remap CapsLock → Escape (Neovim-friendly)
        }
        repeat-delay 250
        repeat-rate 50
    }

    touchpad {
        tap
        dwt                          // Disable while typing
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"         // Raw input for precision
    }
}

// ==============================================================================
// OUTPUTS
// ==============================================================================
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1.0
    position x=0 y=0
}

// ==============================================================================
// LAYOUT — Scrollable tiling
// ==============================================================================
layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"       // MAUVE
        inactive-color "#313244"     // SURFACE0
    }

    border {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#000000b0"
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// ==============================================================================
// SPAWN-AT-STARTUP
// ==============================================================================
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"
spawn-at-startup "sh" "-c" "sleep 1 && swww img ~/.local/share/wallpapers/catppuccin-mocha.png --transition-type fade --transition-duration 1"
spawn-at-startup "pipewire"
spawn-at-startup "wireplumber"

// ==============================================================================
// ENVIRONMENT VARIABLES (Wayland/ROCm)
// ==============================================================================
environment {
    QT_QPA_PLATFORM "wayland"
    GDK_BACKEND "wayland,x11"
    MOZ_ENABLE_WAYLAND "1"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    // ROCm for AMD RX 480 — ensures GPU-accelerated tools launched from Wayland work
    HSA_OVERRIDE_GFX_VERSION "8.0.3"
    ROCR_VISIBLE_DEVICES "0"
}

// ==============================================================================
// WINDOW RULES
// ==============================================================================
window-rule {
    match app-id="qutebrowser"
    default-column-width { proportion 0.667; }
    open-on-workspace "browser"
}

window-rule {
    match app-id="alacritty" title="OSINT Dashboard"
    default-column-width { proportion 1.0; }
    open-on-workspace "monitor"
}

window-rule {
    match app-id="alacritty" title=".*msfconsole.*"
    default-column-width { proportion 0.5; }
    open-on-workspace "exploit"
}

window-rule {
    match app-id="alacritty" title=".*kali.*|.*incus.*"
    open-on-workspace "recon"
}

// Floating rules
window-rule {
    match app-id="pavucontrol"
    open-floating true
    default-floating-position x=50 y=50 relative-to="workspace-start"
    default-column-width { fixed 600; }
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}

// Opacity for terminals
window-rule {
    match app-id="alacritty"
    opacity 0.92
}

// ==============================================================================
// ANIMATIONS
// ==============================================================================
animations {
    slowdown 0.8

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-in-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

// ==============================================================================
// SCREENSHOT CONFIG
// ==============================================================================
screenshot-path "~/Screenshots/niri-%Y-%m-%d_%H-%M-%S.png"

// ==============================================================================
// HOTKEYS
// ==============================================================================
binds {
    // ── Focus navigation ─────────────────────────────────────────────────────
    Mod+H                 { focus-column-left; }
    Mod+L                 { focus-column-right; }
    Mod+J                 { focus-window-down; }
    Mod+K                 { focus-window-up; }
    Mod+Left              { focus-column-left; }
    Mod+Right             { focus-column-right; }
    Mod+Down              { focus-window-down; }
    Mod+Up                { focus-window-up; }

    // ── Column movement ───────────────────────────────────────────────────────
    Mod+Shift+H           { move-column-left; }
    Mod+Shift+L           { move-column-right; }
    Mod+Shift+J           { move-window-down; }
    Mod+Shift+K           { move-window-up; }
    Mod+Shift+Left        { move-column-left; }
    Mod+Shift+Right       { move-column-right; }
    Mod+Shift+Down        { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up          { move-window-up-or-to-workspace-up; }

    // ── Resize ────────────────────────────────────────────────────────────────
    Mod+Ctrl+H            { set-column-width "-10%"; }
    Mod+Ctrl+L            { set-column-width "+10%"; }
    Mod+Ctrl+J            { set-window-height "-10%"; }
    Mod+Ctrl+K            { set-window-height "+10%"; }
    Mod+R                 { switch-preset-column-width; }
    Mod+Shift+R           { reset-window-height; }
    Mod+M                 { maximize-column; }
    Mod+Shift+M           { fullscreen-window; }

    // ── Column layout ─────────────────────────────────────────────────────────
    Mod+Comma             { consume-window-into-column; }
    Mod+Period            { expel-window-from-column; }
    Mod+BracketLeft       { consume-or-expel-window-left; }
    Mod+BracketRight      { consume-or-expel-window-right; }
    Mod+W                 { toggle-column-tabbed-display; }

    // ── Workspaces ───────────────────────────────────────────────────────────
    Mod+1                 { focus-workspace 1; }
    Mod+2                 { focus-workspace 2; }
    Mod+3                 { focus-workspace 3; }
    Mod+4                 { focus-workspace 4; }
    Mod+5                 { focus-workspace 5; }
    Mod+6                 { focus-workspace 6; }
    Mod+7                 { focus-workspace 7; }
    Mod+8                 { focus-workspace 8; }
    Mod+9                 { focus-workspace 9; }
    Mod+Shift+1           { move-column-to-workspace 1; }
    Mod+Shift+2           { move-column-to-workspace 2; }
    Mod+Shift+3           { move-column-to-workspace 3; }
    Mod+Shift+4           { move-column-to-workspace 4; }
    Mod+Shift+5           { move-column-to-workspace 5; }
    Mod+Shift+6           { move-column-to-workspace 6; }
    Mod+Shift+7           { move-column-to-workspace 7; }
    Mod+Shift+8           { move-column-to-workspace 8; }
    Mod+Shift+9           { move-column-to-workspace 9; }
    Mod+Ctrl+Up           { move-workspace-up; }
    Mod+Ctrl+Down         { move-workspace-down; }
    Mod+Page_Up           { focus-workspace-up; }
    Mod+Page_Down         { focus-workspace-down; }
    Mod+Tab               { focus-workspace-previous; }
    Mod+Shift+Tab         { move-column-to-workspace-previous; }

    // ── Applications ──────────────────────────────────────────────────────────
    Mod+Return            { spawn "alacritty"; }
    Mod+Shift+Return      { spawn "alacritty" "-e" "nu"; }
    Mod+B                 { spawn "qutebrowser"; }
    Mod+D                 { spawn "rofi" "-show" "drun"; }
    Mod+Shift+D           { spawn "rofi" "-show" "window"; }
    Mod+E                 { spawn "alacritty" "-e" "nu"; }
    Mod+Shift+E           { spawn "alacritty" "-e" "zsh"; }
    Mod+V                 { spawn "alacritty" "-e" "nvim"; }
    Mod+F                 { spawn "alacritty" "-e" "zsh" "-c" "eza --long --all --git --header --icons && zsh"; }

    // ── OSINT / Ops shortcuts ─────────────────────────────────────────────────
    // Kali ephemeral container
    Mod+Alt+K             { spawn "alacritty" "-e" "bash" "-c" "incus launch images:kali/current kali-ops --ephemeral --profile ephemeral-ops && incus exec kali-ops -- /bin/bash"; }
    // OSINT Dashboard
    Mod+Alt+O             { spawn "alacritty" "-T" "OSINT Dashboard" "-e" "uv" "run" "--with" "textual" "python" "/home/operator/.config/kitty/osint_dashboard.py"; }
    // AI shell (Ollama)
    Mod+Alt+A             { spawn "alacritty" "-e" "bash" "-c" "ollama run llama3.1"; }
    // Open open-webui
    Mod+Alt+W             { spawn "qutebrowser" "http://127.0.0.1:8080"; }
    // Metasploit
    Mod+Alt+M             { spawn "alacritty" "-e" "bash" "-c" "msfconsole"; }
    // Snapper snapshot
    Mod+Alt+S             { spawn "alacritty" "-e" "bash" "-c" "sudo snapper -c root create --description 'PRE-OPS' && echo Done; read"; }
    // Btop
    Mod+Alt+B             { spawn "alacritty" "-e" "btop"; }
    // Lazygit
    Mod+Alt+G             { spawn "alacritty" "-e" "lazygit"; }
    // Nushell pipeline
    Mod+Alt+N             { spawn "alacritty" "-e" "nu"; }

    // ── Screenshots ───────────────────────────────────────────────────────────
    Print                 { screenshot; }
    Shift+Print           { screenshot-screen; }
    Ctrl+Print            { screenshot-window; }

    // ── Volume / media keys ───────────────────────────────────────────────────
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp                          { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown                        { spawn "brightnessctl" "set" "5%-"; }

    // ── Niri management ───────────────────────────────────────────────────────
    Mod+Shift+C           { close-window; }
    Mod+Shift+Q           { quit; }
    Mod+Shift+P           { power-off-monitors; }
    Mod+Ctrl+Shift+T      { toggle-debug-tint; }
    Mod+Shift+Slash       { show-hotkey-overlay; }   // Show this keybind list!
}
